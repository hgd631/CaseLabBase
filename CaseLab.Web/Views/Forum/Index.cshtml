@{
    ViewData["Title"] = "Course Discussion Forums";
}

<div class="row g-4">
    <!-- Left Navigation Panel (role-adaptive, set by JS) -->
    <div class="col-md-3">
        <div class="glass-panel p-3">
            <h5 class="fw-bold mb-4 ps-2" style="font-family: var(--font-heading);">Navigation Hub</h5>
            <ul class="nav flex-column gap-2" id="forumSideNav">
                <!-- Populated by JS based on role -->
            </ul>
        </div>
    </div>

    <!-- Main Forum Content -->
    <div class="col-md-9">
        <div id="student-forum-container-target">
            <div class="glass-panel text-center py-5">
                <div class="spinner-border spinner-border-sm text-cyan me-2" role="status"></div>
                Loading forum threads...
            </div>
        </div>
    </div>
</div>

<script>
// Build role-aware sidebar navigation
window.addEventListener('DOMContentLoaded', () => {
    const navEl = document.getElementById('forumSideNav');
    if (!navEl) return;

    // Wait for state.user to be populated (DOMContentLoaded in app.js runs too)
    setTimeout(() => {
        const user = window.state && window.state.user;
        const isTeacher = user && user.role === 'teacher';

        const links = [
            { href: isTeacher ? '/Instructor/Dashboard' : '/Student/Dashboard',
              icon: '<rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect>',
              label: isTeacher ? 'Instructor Dashboard' : 'Student Dashboard' },
            ...(isTeacher ? [] : [{
              href: '/Student/MistakeBank',
              icon: '<circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>',
              label: 'Mistake Bank'
            }]),
            { href: '/Forum',
              icon: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>',
              label: 'Course Forum',
              active: true }
        ];

        navEl.innerHTML = links.map(l => `
            <li class="nav-item">
                <a class="nav-link ${l.active ? 'text-dark bg-light rounded px-3 py-2 fw-medium border-start border-3 border-indigo' : 'text-secondary rounded px-3 py-2 fw-medium'} d-flex align-items-center" href="${l.href}">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2">${l.icon}</svg>
                    ${l.label}
                </a>
            </li>`).join('');
    }, 80);
});
</script>
