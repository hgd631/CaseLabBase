@{
    ViewData["Title"] = "Active Timed Workspace";
}

<!-- EXAM WORKSPACE PANEL -->
<div id="screen-student-exam" class="screen active" style="width: 100%; max-width: 100%;">
    <div class="glass-panel mb-3 py-3 px-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="badge bg-danger mb-1 text-uppercase text-white" style="font-size: 10px; letter-spacing: 0.05em;">Timed Session</span>
                <h2 id="examTitle" class="fw-bold m-0" style="font-family: var(--font-heading);">Form Task</h2>
            </div>
            <div class="text-end">
                <span class="text-secondary small d-block">SESSION TIMER</span>
                <div id="examTimerDisplay" class="font-monospace fw-bold fs-3 text-cyan">40:00</div>
            </div>
        </div>
    </div>

    <!-- Active workspace which can split -->
    <div id="examWorkspaceLayoutArea" class="row g-3">
        <div class="col-lg-9 mx-auto">
            <div class="glass-panel">
                <div id="studentActiveQuestionsArea">
                    <div class="text-center py-4 text-secondary">
                        <div class="spinner-border spinner-border-sm text-cyan me-2" role="status"></div>
                        Initializing questions...
                    </div>
                </div>
                <div class="mt-4">
                    <button class="btn btn-dark-custom btn-lg w-100 py-3 fw-bold" onclick="lockExamAndOpenSurvey()">
                        Submit Responses & Proceed to Survey
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- REFLECTION SURVEY PANEL -->
<div id="screen-student-survey" class="screen">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="glass-panel">
                <div class="border-bottom border-secondary pb-3 mb-4">
                    <span class="badge bg-indigo mb-1 text-uppercase text-white" style="font-size: 10px; letter-spacing: 0.05em;">Cognitive Evaluation</span>
                    <h2 class="fw-bold m-0" style="font-family: var(--font-heading);">Subjective Feedback Survey</h2>
                    <p class="text-secondary small mt-1 mb-0">Rate the complexity of each task item to configure defect tolerances.</p>
                </div>

                <div id="studentSurveyQuestionsRepetitionArea">
                    <!-- Survey Questions Loop -->
                </div>

                <div class="mt-4">
                    <button class="btn btn-dark-custom btn-lg w-100 py-3 fw-bold" onclick="completeSurveyPipeline()">
                        Commit Review & Publish to SQL Server Registry
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
