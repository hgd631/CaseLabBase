<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CaseLab</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
    <style>
            /* Modern slate navy body background */
            html, body {
                margin: 0;
                padding: 0;
                background: var(--bg-base);
                min-height: 100vh;
            }
    </style>
</head>
<body class="@(ViewData["BodyClass"] ?? "")">
    <header>
        <!-- Navbar: fully transparent so body gradient shows through seamlessly -->
        <nav style="background: transparent; padding: 18px 0; position: relative; z-index: 10;">
            <div class="container-fluid px-4 px-md-5 d-flex align-items-center">
                <a href="/" style="text-decoration:none; display:flex; align-items:center; gap:8px; color:var(--color-text); font-weight:700; font-size:1.1rem;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent-indigo)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                        <polyline points="2 17 12 22 22 17"></polyline>
                        <polyline points="2 12 12 17 22 12"></polyline>
                    </svg>
                    CaseLabBase
                </a>
                <div class="align-items-center ms-auto gap-3" id="appUserSession" style="display: none;">
                    <div id="sessionAvatar" class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold me-2" style="width:36px;height:36px;font-size:14px;background:var(--accent-indigo);"></div>
                    <span id="sessionNameDisplay" class="small me-3 fw-medium" style="color:var(--color-text-muted);"></span>
                    <button onclick="logoutSystem()" style="background:rgba(var(--accent-indigo-rgb),0.12);border:1px solid rgba(var(--accent-indigo-rgb),0.3);border-radius:8px;padding:6px 16px;color:#FFFFFF;font-size:13px;cursor:pointer;">Sign Out</button>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        <div class="fade-in">
            @RenderBody()
        </div>
    </main>

    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
