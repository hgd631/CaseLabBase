<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CaseLab</title>
    <!-- Bootstrap v5.3 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Global Custom Premium Style -->
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
</head>
<body class="@ViewData["BodyClass"]">
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom py-3 mb-4">
            <div class="container">
                <a class="navbar-brand navbar-brand-custom" href="/">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                        <polyline points="2 17 12 22 22 17"></polyline>
                        <polyline points="2 12 12 17 22 12"></polyline>
                    </svg>
                    CaseLab
                </a>

                <div class="align-items-center ms-auto gap-3" id="appUserSession" style="display: none;">



                    <div id="sessionAvatar" class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; font-size: 14px; background: var(--accent-indigo);"></div>
                    <span id="sessionNameDisplay" class="small fw-medium text-secondary"></span>
                    <button class="btn btn-sm btn-outline-custom" onclick="logoutSystem()">Sign Out</button>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container">
        <div class="fade-in">
            @RenderBody()
        </div>
    </main>

    <!-- App Logic Script -->
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
