@{
    ViewData["Title"] = "Instructor Dashboard Portal";
}

<!-- Tab Navigation Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="glass-panel py-3 px-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <h4 class="fw-bold m-0" style="font-family: var(--font-heading);">Instructor Panel Workspace</h4>
                <ul class="nav nav-tabs-custom m-0" id="teacherTabs">
                    <li class="nav-item">
                        <span class="nav-link-custom active" id="tab-btn-analytics" onclick="switchTeacherTab('analytics')">📋 Quizzes & Grading</span>
                    </li>
                    <li class="nav-item">
                        <span class="nav-link-custom" id="tab-btn-forum" onclick="switchTeacherTab('forum')">💬 Course Discussions</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- ANALYTICS/QUIZZES TAB CONTENT -->
<div id="teacher-tab-analytics" class="teacher-tab-content">
    <div class="row g-4">
        <!-- Left Sidebar: Quiz List Selection -->
        <div class="col-md-3">
            <div class="glass-panel p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3 ps-1">
                    <h5 class="fw-bold m-0" style="font-family: var(--font-heading);">Quizzes</h5>
                    <button class="btn btn-sm btn-dark-custom py-1 px-2 fw-semibold" style="font-size: 11.5px;" onclick="enterCreateQuizMode()">➕ Create Quiz</button>
                </div>
                <p class="text-secondary small mb-3 ps-1">Select a quiz to load details:</p>
                <div id="quizListSidebarContainer" class="d-flex flex-column gap-2" style="max-height: 500px; overflow-y: auto;">
                    <!-- Quiz buttons will be dynamically injected here -->
                    <div class="text-center py-3 text-secondary small">
                        <div class="spinner-border spinner-border-sm text-cyan me-1" role="status"></div>
                        Loading quizzes...
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Content Area: Multi-Tab Quiz Console or Create Quiz Canvas -->
        <div class="col-md-9">

            <!-- Welcome Info Display (when nothing is selected yet) -->
            <div id="teacherDashboardEmptyPlaceholder" class="glass-panel text-center py-5">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" stroke="var(--accent-cyan)" stroke-width="1.5" viewBox="0 0 24 24" class="mb-3">
                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
                </svg>
                <h5 class="fw-bold mb-2">No Quiz Selected</h5>
                <p class="text-secondary small mb-0">Select a quiz from the list on the left, or click "Create Quiz" to make a new one.</p>
            </div>

            <!-- 1. Selected Quiz Details Container -->
            <div id="quizSelectedViewContainer" class="d-none">
                <!-- Quiz Header -->
                <div class="glass-panel py-3 px-4 mb-4">
                    <h5 class="text-secondary small text-uppercase mb-1">Active Selected Quiz</h5>
                    <h4 id="activeQuizTitleHeader" class="fw-bold m-0 text-cyan">--</h4>
                </div>

                <!-- Sub Tab Navigation Horizontal -->
                <div class="row mb-4">
                    <div class="col-12">
                        <ul class="nav nav-tabs-custom m-0 border-bottom-0" id="quizSubTabs" style="gap: 10px;">
                            <li class="nav-item">
                                <span class="nav-link-custom active" id="quiz-sub-btn-view" onclick="switchQuizSubTab('view')">👁 View Quiz</span>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link-custom" id="quiz-sub-btn-grading" onclick="switchQuizSubTab('grading')">✍ Grading</span>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link-custom" id="quiz-sub-btn-diagnostics" onclick="switchQuizSubTab('diagnostics')">📊 Diagnostics</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Sub-Tab 1: View Quiz Content Panel -->
                <div id="quiz-sub-tab-content-view" class="quiz-sub-tab-content">
                    <div class="glass-panel">
                        <h5 class="fw-bold mb-1" style="font-family: var(--font-heading);">Quiz Questions & Answer Keys</h5>
                        <p class="text-secondary small mb-4">Mutate correct keys for MCQ to trigger system re-grading, or add marking guidelines for Essay questions.</p>
                        <div id="viewQuizQuestionsContainer" class="d-flex flex-column gap-3">
                            <!-- Question edit cards will be dynamically injected here -->
                        </div>
                    </div>
                </div>

                <!-- Sub-Tab 2: Grading Content Panel -->
                <div id="quiz-sub-tab-content-grading" class="quiz-sub-tab-content d-none">
                    <div class="glass-panel">
                        <div class="d-flex justify-content-between align-items-center flex-wrap border-bottom border-secondary pb-3 mb-3">
                            <h4 id="rosterBlockHeadingTitle" class="fw-bold m-0" style="font-family: var(--font-heading);">Student Submissions</h4>

                            <!-- Roster Sub-Tabs -->
                            <div class="sub-tab-container m-0 border-0">
                                <ul class="sub-tab-nav">
                                    <li class="sub-tab-link active" id="sub-btn-pending" onclick="switchRosterSubTab('pending')">
                                        Pending
                                    </li>
                                    <li class="sub-tab-link" id="sub-btn-graded" onclick="switchRosterSubTab('graded')">
                                        Graded
                                    </li>
                                    <li class="sub-tab-link d-flex align-items-center gap-1" id="sub-btn-dispute" onclick="switchRosterSubTab('dispute')">
                                        Disputes
                                        <span id="subTabTicketBadgeCount" class="badge bg-danger rounded-pill" style="display: none; font-size: 10px;">0</span>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-custom w-100">
                                <thead>
                                    <tr>
                                        <th>Student Name</th>
                                        <th>Submission File</th>
                                        <th class="text-center" id="dynamicRosterNoteColumnHeader">Feedback</th>
                                        <th class="text-center">Score</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="multiStudentRosterTableBody">
                                    <!-- Dynamic roster rows -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Sub-Tab 3: Diagnostics Content Panel -->
                <div id="quiz-sub-tab-content-diagnostics" class="quiz-sub-tab-content d-none">
                    <!-- Stat Indicators Grid -->
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <div class="glass-panel text-center py-4">
                                <span class="text-secondary small d-block mb-1">Submissions</span>
                                <div id="analyticsSubmissionCount" class="fs-4 fw-bold">--</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="glass-panel text-center py-4">
                                <span class="text-secondary small d-block mb-2">Failure Rate</span>
                                <div class="d-flex justify-content-center align-items-center gap-2">
                                    <span id="analyticsFailureRate" class="badge-custom badge-custom-emerald">--</span>
                                    <span id="classAvgLabelField" class="text-secondary small">--</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Diagnostics Panel -->
                    <div class="row">
                        <div class="col-12">
                            <div class="glass-panel">
                                <h4 class="fw-bold mb-1" style="font-family: var(--font-heading);">📊 Quiz Statistics</h4>
                                <p class="text-secondary small mb-4">Overview of class grades, difficulty ratings, and student flags.</p>
                                <div id="analyticsQuestionDiagnosticsContainer" class="d-flex flex-column gap-3">
                                    <!-- Dynamic questions diagnostics injected here -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Create Quiz Canvas Container -->
            <div id="quizCreateViewContainer" class="d-none">
                <div class="row g-4">
                    <!-- Configuration Control Panel -->
                    <div class="col-lg-5">
                        <div class="glass-panel">
                            <h4 class="fw-bold mb-3" style="font-family: var(--font-heading);">Create Quiz</h4>
                            <p class="text-secondary small mb-4">Fill in the details below to create a new quiz.</p>

                            <div class="mb-4">
                                <label class="form-label text-secondary small fw-semibold">Quiz Title:</label>
                                <input type="text" class="form-control" id="inputTaskTitle" placeholder="e.g. Arrays Quiz">
                            </div>

                            <!-- Quiz Configuration Parameters -->
                            <div class="mb-4 p-3 border rounded bg-light" style="border-color: var(--border-color) !important;">
                                <h6 class="fw-bold mb-3 text-dark small" style="font-family: var(--font-heading);">Settings</h6>

                                <div class="mb-3">
                                    <label class="form-label text-secondary small fw-semibold">Time Limit (Minutes):</label>
                                    <input type="number" class="form-control form-control-sm" id="inputQuizTimeLimit" value="40" min="1">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label text-secondary small fw-semibold">Total Score (Points):</label>
                                    <input type="number" step="0.1" class="form-control form-control-sm" id="inputQuizTotalScore" value="10.0" min="1">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label text-secondary small fw-semibold">Quiz Deadline (Date & Time):</label>
                                    <input type="datetime-local" class="form-control form-control-sm" id="inputQuizDeadline">
                                </div>

                                <div class="d-flex gap-4 mb-2">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" id="inputIsQuizOpen" checked>
                                        <label class="form-check-label text-secondary small fw-semibold" for="inputIsQuizOpen">Quiz Active</label>
                                    </div>

                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" id="inputIsForumOpen" checked>
                                        <label class="form-check-label text-secondary small fw-semibold" for="inputIsForumOpen">Forum Active</label>
                                    </div>
                                </div>
                            </div>

                            <div class="d-grid">
                                <button class="btn btn-dark-custom btn-lg py-2.5 fw-bold" onclick="instructorPublishTask()">
                                    Publish Task & Clear Previous Scores
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Dynamic Questions Builder -->
                    <div class="col-lg-7">
                        <div class="glass-panel h-100">
                            <h4 class="fw-bold mb-3" style="font-family: var(--font-heading);">Quiz Question Builder</h4>
                            <div class="mb-3 d-flex gap-2">
                                <button class="btn btn-sm btn-outline-custom text-indigo border-indigo" type="button" onclick="addCustomQuestionField('MCQ')">➕ Add MCQ Question</button>
                                <button class="btn btn-sm btn-outline-custom text-indigo border-indigo" type="button" onclick="addCustomQuestionField('Essay')">➕ Add Essay Question</button>
                            </div>
                            <div id="custom-questions-list-container" class="d-flex flex-column gap-3" style="max-height: 550px; overflow-y: auto; padding-right: 5px;">
                                <!-- Dynamic question cards injected here -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- COURSE FORUMS TAB CONTENT -->
<div id="teacher-tab-forum" class="teacher-tab-content d-none">
    <div class="row">
        <div class="col-12" id="standalone-teacher-forum-container">
            <!-- Dynamic Forum Room Injection -->
        </div>
    </div>
</div>
