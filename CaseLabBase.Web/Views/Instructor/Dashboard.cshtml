@{
    ViewData["Title"] = "Instructor Dashboard Portal";
}

<!-- Tab Navigation Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="glass-panel py-3 px-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <h4 class="fw-bold m-0" style="font-family: var(--font-heading);">Instructor Panel Workspace</h4>
                <ul class="nav nav-tabs-custom m-0" id="teacherTabs">
                    <li class="nav-item">
                        <span class="nav-link-custom active" id="tab-btn-analytics" onclick="switchTeacherTab('analytics')">Roster Analytics</span>
                    </li>
                    <li class="nav-item">
                        <span class="nav-link-custom" id="tab-btn-manager" onclick="switchTeacherTab('manager')">Assignment Factory</span>
                    </li>
                    <li class="nav-item">
                        <span class="nav-link-custom" id="tab-btn-forum" onclick="switchTeacherTab('forum')">Course Discussions</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- ANALYTICS TAB CONTENT -->
<div id="teacher-tab-analytics" class="teacher-tab-content">
    <div class="row g-4">
        <!-- Left Sidebar: Quiz List Selection -->
        <div class="col-md-3">
            <div class="glass-panel p-3 h-100">
                <h5 class="fw-bold mb-3 ps-1" style="font-family: var(--font-heading);">Assessment List</h5>
                <p class="text-secondary small mb-3 ps-1">Select a quiz to load its roster and statistics:</p>
                <div id="quizListSidebarContainer" class="d-flex flex-column gap-2" style="max-height: 500px; overflow-y: auto;">
                    <!-- Quiz buttons will be dynamically injected here -->
                    <div class="text-center py-3 text-secondary small">
                        <div class="spinner-border spinner-border-sm text-cyan me-1" role="status"></div>
                        Loading quizzes...
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Content Area: Analytics, Roster & Diagnostics -->
        <div class="col-md-9">
            <!-- Stat Indicators Grid -->
            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <div class="glass-panel text-center py-4">
                        <span class="text-secondary small d-block mb-1">ACTIVE ASSESSMENT TASK</span>
                        <h5 id="analyticsTaskTitle" class="fw-bold font-monospace mb-0" style="font-size: 15px;">--</h5>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="glass-panel text-center py-4">
                        <span class="text-secondary small d-block mb-1">TOTAL CLASS SUBMISSIONS</span>
                        <div id="analyticsSubmissionCount" class="fs-4 fw-bold">--</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="glass-panel text-center py-4">
                        <span class="text-secondary small d-block mb-2">ANOMALY DEFECT METRIC</span>
                        <div class="d-flex justify-content-center align-items-center gap-2">
                            <span id="analyticsFailureRate" class="badge-custom badge-custom-emerald">--</span>
                            <span id="classAvgLabelField" class="text-secondary small">--</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Inline MCQ Key Mutator Section -->
            <div class="row mb-4" id="instructorPerQuestionInlineEditSection" style="display: none;">
                <div class="col-12">
                    <div class="glass-panel py-3 px-4 border-cyan" style="border-color: rgba(6, 182, 212, 0.15);">
                        <div id="inlineQuestionEditContainer"></div>
                    </div>
                </div>
            </div>

            <!-- Student Roster Queue Table Panel -->
            <div class="row">
                <div class="col-12">
                    <div class="glass-panel">
                        <div class="d-flex justify-content-between align-items-center flex-wrap border-bottom border-secondary pb-3 mb-3">
                            <h4 id="rosterBlockHeadingTitle" class="fw-bold m-0" style="font-family: var(--font-heading);">Ungraded Student Submissions Queue</h4>
                            <h4 id="rosterBlockHeadingTitle" class="fw-bold m-0" style="font-family: var(--font-heading);">Ungraded Student Submissions Queue</h4>
                            <button class="btn btn-sm btn-outline-custom text-indigo border-indigo" onclick="remindPendingStudents()">
                                Remind Pending Students
                            </button>
                            <!-- Roster Sub-Tabs -->
                            <div class="sub-tab-container m-0 border-0">
                                <ul class="sub-tab-nav">
                                    <li class="sub-tab-link active" id="sub-btn-pending" onclick="switchRosterSubTab('pending')">
                                        Pending Ungraded
                                    </li>
                                    <li class="sub-tab-link" id="sub-btn-graded" onclick="switchRosterSubTab('graded')">
                                        Graded Logs
                                    </li>
                                    <li class="sub-tab-link d-flex align-items-center gap-1" id="sub-btn-dispute" onclick="switchRosterSubTab('dispute')">
                                        Active Disputes
                                        <span id="subTabTicketBadgeCount" class="badge bg-danger rounded-pill" style="display: none; font-size: 10px;">0</span>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-custom w-100">
                                <thead>
                                    <tr>
                                        <th>Student Identity</th>
                                        <th>Submission Payload Asset</th>
                                        <th class="text-center" id="dynamicRosterNoteColumnHeader">Stated Survey Pain Point</th>
                                        <th class="text-center">Score Result</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="multiStudentRosterTableBody">
                                    <tr>
                                        <td colspan="5" class="text-center text-secondary p-4 small">
                                            <div class="spinner-border spinner-border-sm text-cyan me-2" role="status"></div>
                                            Loading student roster datasets...
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Per-Question Analytics and Diagnostics Panel -->
            <div class="row mt-4">
                <div class="col-12">
                    <div class="glass-panel">
                        <h4 class="fw-bold mb-1" style="font-family: var(--font-heading);">📊 Active Quiz Question Diagnostics</h4>
                        <p class="text-secondary small mb-4">Classroom performance analytics, cognitive difficulty distributions, and anomaly flag warnings per question.</p>
                        <div id="analyticsQuestionDiagnosticsContainer" class="d-flex flex-column gap-3">
                            <div class="text-center text-secondary py-3 small">No active diagnostic metrics generated. Please wait for students to submit and grade answers.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MANAGER TAB CONTENT -->
<div id="teacher-tab-manager" class="teacher-tab-content d-none">
    <div class="row g-4">
        <!-- Configuration Control Panel -->
        <div class="col-lg-5">
            <div class="glass-panel">
                <h4 class="fw-bold mb-3" style="font-family: var(--font-heading);">Assessment Configuration Factory</h4>
                <p class="text-secondary small mb-4">Construct new classroom tasks and upload optional PDF exam materials.</p>

                <div class="mb-4">
                    <label class="form-label text-secondary small fw-semibold">1. DEFINE TASK NAME TITLE:</label>
                    <input type="text" class="form-control" id="inputTaskTitle" placeholder="e.g. Assessment Form #3: Intermediate Array Logic">
                </div>

                <div class="mb-4">
                    <label class="form-label text-secondary small fw-semibold">2. SELECT QUIZ FORMAT:</label>
                    <select id="inputQuizMode" class="form-select form-select-sm" onchange="toggleQuizModeLayout()">
                        <option value="Manual" selected>Manual Text Quiz (Dynamic text prompts)</option>
                        <option value="PDF">PDF Exam (Upload document + configure answer keys)</option>
                    </select>
                </div>

                <!-- PDF Document Upload Field (Visible only in PDF Mode) -->
                <div id="pdfUploadWrapper" class="d-none">
                    <div class="mb-4 p-3 border rounded bg-light" style="border-color: var(--border-color) !important;">
                        <h6 class="fw-bold mb-2 text-dark small" style="font-family: var(--font-heading);">3. ATTACH PDF EXAM DOCUMENT (REQUIRED)</h6>
                        <label class="form-label text-secondary small">Students will view this PDF side-by-side with answer fields:</label>
                        <div class="input-group input-group-sm">
                            <input type="file" class="form-control" id="inputQuizPdf" accept="application/pdf">
                            <button class="btn btn-outline-danger" type="button" onclick="clearUploadedPdfField()">Clear</button>
                        </div>
                        <div id="quizPdfStatusLabel" class="small text-secondary mt-2">No PDF document attached.</div>
                    </div>
                </div>

                <!-- Quiz Configuration Parameters -->
                <div class="mb-4 p-3 border rounded bg-light" style="border-color: var(--border-color) !important;">
                    <h6 class="fw-bold mb-3 text-dark small" style="font-family: var(--font-heading);">4. ASSESSMENT CONTROL PARAMETERS</h6>
                    
                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-semibold">Time Limit (Minutes):</label>
                        <input type="number" class="form-control form-control-sm" id="inputQuizTimeLimit" value="40" min="1">
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-semibold">Total Score (Points):</label>
                        <input type="number" step="0.1" class="form-control form-control-sm" id="inputQuizTotalScore" value="10.0" min="1">
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-semibold">Quiz Deadline (Date & Time):</label>
                        <input type="datetime-local" class="form-control form-control-sm" id="inputQuizDeadline">
                    </div>

                    <div class="d-flex gap-4 mb-2">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="inputIsQuizOpen" checked>
                            <label class="form-check-label text-secondary small fw-semibold" for="inputIsQuizOpen">Quiz Active</label>
                        </div>

                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="inputIsForumOpen" checked>
                            <label class="form-check-label text-secondary small fw-semibold" for="inputIsForumOpen">Forum Active</label>
                        </div>
                    </div>
                </div>

                <div class="d-grid">
                    <button class="btn btn-dark-custom btn-lg py-2.5 fw-bold" onclick="instructorPublishTask()">
                        Publish Task & Clear Previous Scores
                    </button>
                </div>
            </div>
        </div>

        <!-- Dynamic Questions Builder -->
        <div class="col-lg-7">
            <div class="glass-panel h-100">
                <h4 class="fw-bold mb-3" style="font-family: var(--font-heading);">Quiz Question Builder</h4>
                <div class="mb-3 d-flex gap-2">
                    <button class="btn btn-sm btn-outline-custom text-indigo border-indigo" type="button" onclick="addCustomQuestionField('MCQ')">➕ Add MCQ Question</button>
                    <button class="btn btn-sm btn-outline-custom text-indigo border-indigo" type="button" onclick="addCustomQuestionField('Essay')">➕ Add Essay Question</button>
                </div>
                <div id="custom-questions-list-container" class="d-flex flex-column gap-3" style="max-height: 550px; overflow-y: auto; padding-right: 5px;">
                    <!-- Dynamic question cards injected here -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- COURSE FORUMS TAB CONTENT -->
<div id="teacher-tab-forum" class="teacher-tab-content d-none">
    <div class="row">
        <div class="col-12" id="standalone-teacher-forum-container">
            <!-- Dynamic Forum Room Injection -->
        </div>
    </div>
</div>
