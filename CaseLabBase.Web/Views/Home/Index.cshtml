@{
    ViewData["Title"] = "Welcome to CaseLab";
    Layout = "~/Views/Shared/_LayoutFull.cshtml";
}

<!-- ===== HERO SECTION ===== -->
<section style="min-height: calc(100vh - 72px); display: flex; align-items: center; position: relative; overflow: hidden;">

    <!-- Ambient teal orbs -->
    <div style="position:absolute; top:-100px; left:-120px; width:500px; height:500px; border-radius:50%; background:radial-gradient(circle, rgba(20,163,132,0.12) 0%, transparent 65%); pointer-events:none;"></div>
    <div style="position:absolute; bottom:-120px; right:-80px; width:550px; height:550px; border-radius:50%; background:radial-gradient(circle, rgba(20,163,132,0.09) 0%, transparent 65%); pointer-events:none;"></div>
    <div style="position:absolute; top:35%; left:50%; width:300px; height:300px; border-radius:50%; background:radial-gradient(circle, rgba(143,168,158,0.06) 0%, transparent 70%); pointer-events:none;"></div>

    <div class="container-fluid px-4 px-md-5 px-lg-5" style="max-width:1400px; margin:0 auto; position:relative; z-index:1;">
        <div class="row align-items-center g-5">

            <!-- Left: headline -->
            <div class="col-lg-6">
                <!-- Badge -->
                <div class="mb-3">
                    <span style="display:inline-flex; align-items:center; gap:6px; background:rgba(20,163,132,0.15); border:1px solid rgba(20,163,132,0.35); border-radius:100px; padding:4px 14px; font-size:12px; font-weight:600; color:#14A384; letter-spacing:0.05em; text-transform:uppercase;">
                        <span style="width:6px;height:6px;border-radius:50%;background:#14A384;display:inline-block; box-shadow:0 0 8px rgba(20,163,132,0.8);"></span>
                        Smart Learning Platform
                    </span>
                </div>

                <!-- Title -->
                <h1 style="font-family: var(--font-heading); font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 800; color: #FFFFFF; line-height: 1.1; margin-bottom: 1.25rem;">
                    CaseLab<br>
                    <span style="background: linear-gradient(90deg, #14A384, #8FA89E); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;">System</span>
                </h1>

                <!-- Subtitle -->
                <p style="color: #8FA89E; font-size: 1.05rem; line-height: 1.75; margin-bottom: 2rem; max-width: 500px;">
                    A relational assessment simulator mapping cognitive reflections, quiz analytics, and private dispute audit loops — built for modern classrooms.
                </p>

                <!-- CTA Button -->
                <div class="d-flex gap-3 flex-wrap">
                    <button onclick="window.location.href='/Home/Login'"
                        style="background: linear-gradient(135deg, #14A384, #0d7a62); border:none; border-radius:12px; padding:14px 32px; font-weight:700; font-size:1rem; color:#fff; cursor:pointer; box-shadow:0 4px 24px rgba(20,163,132,0.35); transition:all 0.2s;"
                        onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 32px rgba(20,163,132,0.45)'"
                        onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 24px rgba(20,163,132,0.35)'">
                        Enter Simulator Portal →
                    </button>
                </div>

                <!-- Stats row -->
                <div class="d-flex gap-4 mt-5 flex-wrap">
                    <div>
                        <div style="font-size:1.6rem; font-weight:800; color:#FFFFFF; font-family: var(--font-heading);">MCQ + Essay</div>
                        <div style="font-size:12px; color:#8FA89E; letter-spacing:0.04em;">Quiz Modes</div>
                    </div>
                    <div style="width:1px; background:rgba(143,168,158,0.15);"></div>
                    <div>
                        <div style="font-size:1.6rem; font-weight:800; color:#FFFFFF; font-family: var(--font-heading);">Real-Time</div>
                        <div style="font-size:12px; color:#8FA89E; letter-spacing:0.04em;">SQL Analytics</div>
                    </div>
                    <div style="width:1px; background:rgba(143,168,158,0.15);"></div>
                    <div>
                        <div style="font-size:1.6rem; font-weight:800; color:#FFFFFF; font-family: var(--font-heading);">1-on-1</div>
                        <div style="font-size:12px; color:#8FA89E; letter-spacing:0.04em;">Dispute Audits</div>
                    </div>
                </div>
            </div>

            <!-- Right: feature cards -->
            <div class="col-lg-6">
                <div class="row g-3">

                    <!-- Card 1: Timed Exam -->
                    <div class="col-6">
                        <div style="background:#132A30; border:1px solid rgba(20,163,132,0.18); border-radius:16px; padding:20px; height:100%; transition:all 0.2s;"
                             onmouseover="this.style.borderColor='rgba(20,163,132,0.45)'; this.style.transform='translateY(-3px)'"
                             onmouseout="this.style.borderColor='rgba(20,163,132,0.18)'; this.style.transform='translateY(0)'">
                            <div style="width:40px;height:40px;border-radius:10px;background:rgba(20,163,132,0.18);display:flex;align-items:center;justify-content:center;margin-bottom:12px;">
                                <svg width="20" height="20" fill="none" stroke="#14A384" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                            </div>
                            <h6 style="color:#FFFFFF;font-weight:700;margin-bottom:6px;font-size:14px;">Timed Exam Workspace</h6>
                            <p style="color:#8FA89E;font-size:12px;margin:0;line-height:1.5;">MCQ + Essay with flag-to-revisit, survey ratings, and auto-timer.</p>
                        </div>
                    </div>

                    <!-- Card 2: Instructor Console -->
                    <div class="col-6">
                        <div style="background:#132A30; border:1px solid rgba(20,163,132,0.18); border-radius:16px; padding:20px; height:100%; transition:all 0.2s;"
                             onmouseover="this.style.borderColor='rgba(20,163,132,0.45)'; this.style.transform='translateY(-3px)'"
                             onmouseout="this.style.borderColor='rgba(20,163,132,0.18)'; this.style.transform='translateY(0)'">
                            <div style="width:40px;height:40px;border-radius:10px;background:rgba(143,168,158,0.12);display:flex;align-items:center;justify-content:center;margin-bottom:12px;">
                                <svg width="20" height="20" fill="none" stroke="#8FA89E" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="9" x2="15" y2="9"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="15" y2="17"/></svg>
                            </div>
                            <h6 style="color:#FFFFFF;font-weight:700;margin-bottom:6px;font-size:14px;">Instructor Console</h6>
                            <p style="color:#8FA89E;font-size:12px;margin:0;line-height:1.5;">Publish quizzes, view class analytics, mutate scoring keys live.</p>
                        </div>
                    </div>

                    <!-- Card 3: Mistake Bank -->
                    <div class="col-6">
                        <div style="background:#132A30; border:1px solid rgba(20,163,132,0.18); border-radius:16px; padding:20px; height:100%; transition:all 0.2s;"
                             onmouseover="this.style.borderColor='rgba(20,163,132,0.45)'; this.style.transform='translateY(-3px)'"
                             onmouseout="this.style.borderColor='rgba(20,163,132,0.18)'; this.style.transform='translateY(0)'">
                            <div style="width:40px;height:40px;border-radius:10px;background:rgba(20,163,132,0.1);display:flex;align-items:center;justify-content:center;margin-bottom:12px;">
                                <svg width="20" height="20" fill="none" stroke="#14A384" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                            </div>
                            <h6 style="color:#FFFFFF;font-weight:700;margin-bottom:6px;font-size:14px;">Mistake Bank</h6>
                            <p style="color:#8FA89E;font-size:12px;margin:0;line-height:1.5;">Personal defect cards per question with 1-on-1 dispute forums.</p>
                        </div>
                    </div>

                    <!-- Card 4: Quiz Forum Hub -->
                    <div class="col-6">
                        <div style="background:#132A30; border:1px solid rgba(20,163,132,0.18); border-radius:16px; padding:20px; height:100%; transition:all 0.2s;"
                             onmouseover="this.style.borderColor='rgba(20,163,132,0.45)'; this.style.transform='translateY(-3px)'"
                             onmouseout="this.style.borderColor='rgba(20,163,132,0.18)'; this.style.transform='translateY(0)'">
                            <div style="width:40px;height:40px;border-radius:10px;background:rgba(143,168,158,0.1);display:flex;align-items:center;justify-content:center;margin-bottom:12px;">
                                <svg width="20" height="20" fill="none" stroke="#8FA89E" stroke-width="2" viewBox="0 0 24 24"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                            </div>
                            <h6 style="color:#FFFFFF;font-weight:700;margin-bottom:6px;font-size:14px;">Quiz Forum Hub</h6>
                            <p style="color:#8FA89E;font-size:12px;margin:0;line-height:1.5;">Per-quiz Q&amp;A forum for public discussions and class Q&amp;A.</p>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>
