@{
    ViewData["Title"] = "Welcome to CaseLab";
    Layout = "~/Views/Shared/_LayoutFull.cshtml";
}

<style>
   

    .hero-section {
        min-height: 85vh;
        display: flex;
        align-items: center;
    }

    
    .hero-title {
        font-family: var(--font-heading);
        font-size: clamp(3rem, 5vw, 4rem);
        font-weight: 800;
        color: var(--color-text);
        line-height: 1.1;
    }

    .brand-blue {
        color: var(--accent-indigo); 
    }

    
    .btn-case {
        background-color: var(--accent-indigo);
        color: #ffffff !important;
        padding: 14px 35px;
        border-radius: var(--radius-md);
        font-weight: 700;
        text-decoration: none;
        display: inline-block;
        border: none;
        transition: var(--transition-smooth);
    }

        .btn-case:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }

    
    .feature-item {
        background: var(--bg-surface);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        padding: 25px;
        height: 100%;
        transition: var(--transition-smooth);
    }

        .feature-item:hover {
            border-color: var(--accent-indigo);
            transform: translateY(-5px);
        }

    .icon-wrap {
        width: 40px;
        height: 40px;
        background-color: var(--accent-indigo-glow);
        color: var(--accent-indigo);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 15px;
    }
</style>

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">

            <!-- LEFT: Brand headline and CTA -->
            <div class="col-lg-6">
                <h1 class="hero-title">
                    CaseLab <br />
                    <span class="brand-blue">Feedback System</span>
                </h1>
                <p class="text-secondary mt-4 mb-4 fs-5" style="max-width: 500px;">
                    A simple academic tool for students to take quizzes and instructors to provide structured feedback.
                </p>
                <a href="/Home/Login" class="btn-case">
                    Go to Login Portal &rarr;
                </a>
            </div>

            <!-- RIGHT: 4 Feature cards -->
            <div class="col-lg-6">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="feature-item">
                            <div class="icon-wrap"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg></div>
                            <h6 class="fw-bold">Timed Exam</h6>
                            <p class="small text-muted mb-0">Automatic countdown and submission.</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="feature-item">
                            <div class="icon-wrap"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2" /></svg></div>
                            <h6 class="fw-bold">Grading Hub</h6>
                            <p class="small text-muted mb-0">Evaluate student work easily.</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="feature-item">
                            <div class="icon-wrap"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 14l9-5-9-5-9 5 9 5z" /><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.052 0 0012 20.052" /></svg></div>
                            <h6 class="fw-bold">Resources</h6>
                            <p class="small text-muted mb-0">Access specific study materials.</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="feature-item">
                            <div class="icon-wrap"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg></div>
                            <h6 class="fw-bold">Discussion</h6>
                            <p class="small text-muted mb-0">Class-wide forum for help.</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>