@{
    ViewData["Title"] = "Portal Access Control";
    ViewData["BodyClass"] = "dark-theme";
}

<script>
    localStorage.removeItem('caselab_user');
</script>

<div class="row justify-content-center align-items-center min-vh-75" style="margin-top: 5vh;">
    <div class="col-md-6 col-lg-5">
        <div class="glass-panel text-center px-4 py-5 shadow-lg">
            <div class="mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle border mb-3" style="width: 72px; height: 72px; background: rgba(20, 163, 132, 0.1); border-color: rgba(20, 163, 132, 0.3) !important; box-shadow: 0 0 15px rgba(20, 163, 132, 0.15);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--accent-indigo)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </div>
                <h2 class="fw-bold mb-1" style="font-family: var(--font-heading);">Portal Access Control</h2>
                <p class="text-secondary small">Identify session credentials to initialize workspace</p>
            </div>

            <div class="text-start mb-4">
                <label class="form-label text-secondary small fw-semibold">SELECT USER PROFILE REGISTER:</label>
                <div class="d-grid gap-2">
                    <div class="mcq-option-card px-3 py-2.5 mb-2" onclick="loginAsRole('s1')">
                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center font-monospace fw-bold" style="width: 28px; height: 28px; background-color: var(--accent-indigo); font-size: 12px;">HD</div>
                        <div>
                            <span class="d-block fw-medium" style="font-size: 13.5px;">Han Dang</span>
                            <span class="text-secondary" style="font-size: 11px;">Active Student (ID: s1)</span>
                        </div>
                    </div>

                    <div class="mcq-option-card px-3 py-2.5 mb-2" onclick="loginAsRole('s2')">
                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center font-monospace fw-bold" style="width: 28px; height: 28px; background-color: var(--accent-indigo); font-size: 12px;">JS</div>
                        <div>
                            <span class="d-block fw-medium" style="font-size: 13.5px;">Sunny Soni</span>
                            <span class="text-secondary" style="font-size: 11px;">Active Student (ID: s2)</span>
                        </div>
                    </div>

                    <div class="mcq-option-card px-3 py-2.5 mb-2" onclick="loginAsRole('s3')">
                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center font-monospace fw-bold" style="width: 28px; height: 28px; background-color: var(--accent-indigo); font-size: 12px;">AC</div>
                        <div>
                            <span class="d-block fw-medium" style="font-size: 13.5px;">Ethan Longney</span>
                            <span class="text-secondary" style="font-size: 11px;">Active Student (ID: s3)</span>
                        </div>
                    </div>

                    <div class="mcq-option-card px-3 py-2.5 mb-2" onclick="loginAsRole('t1')" style="border-color: rgba(20, 163, 132, 0.25);">
                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center font-monospace fw-bold" style="width: 28px; height: 28px; background-color: var(--accent-cyan); font-size: 12px;">AB</div>
                        <div>
                            <span class="d-block fw-medium" style="font-size: 13.5px;">Dr. Ali Bayeh</span>
                            <span class="text-secondary" style="font-size: 11px;">Course Instructor (ID: t1)</span>
                        </div>
                    </div>
                </div>
            </div>

           
        </div>
    </div>
</div>
