@{
    ViewData["Title"] = "Student Dashboard";
}

<div class="row g-4">
    <!-- Left Navigation Panel -->
    <div class="col-md-3">
        <div class="glass-panel p-3">
            <h5 class="fw-bold mb-4 ps-2" style="font-family: var(--font-heading);">Menu</h5>
            <ul class="nav flex-column gap-2">
                <li class="nav-item">
                    <a class="nav-link text-dark bg-light rounded px-3 py-2 fw-medium border-start border-3 border-indigo d-flex align-items-center" href="/Student/Dashboard">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2 text-indigo"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
                        Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-secondary hover-indigo rounded px-3 py-2 fw-medium d-flex align-items-center justify-content-between" href="/Student/MistakeBank">
                        <span class="d-flex align-items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                            Mistake Bank
                        </span>
                        <span id="dashMistakeBadge" class="badge bg-danger rounded-pill" style="font-size: 11px;">0</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-secondary hover-indigo rounded px-3 py-2 fw-medium d-flex align-items-center" href="/Forum">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                        Course Forum
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Main Workspace Content -->
    <div class="col-md-9">
        <div class="glass-panel mb-4">
            <h2 class="fw-bold mb-2" style="font-family: var(--font-heading);">Assignments</h2>
            <p class="text-secondary small mb-4">Select a quiz from the list to start taking it.</p>

            <div id="assignmentContainerStudent">
                <div class="text-center py-4 text-secondary">
                    <div class="spinner-border spinner-border-sm text-cyan me-2" role="status"></div>
                    Loading assignments...
                </div>
            </div>
        </div>

        <div class="glass-panel">
            <h5 class="fw-bold mb-3" style="font-family: var(--font-heading);">Instructions</h5>
            <div class="small text-secondary lh-lg">
                <p class="mb-2">1. Click <strong>"Start Quiz"</strong> to enter the quiz page. You will have a 40-minute limit to submit your answers.</p>
                <p class="mb-2">2. After finishing the quiz, you can submit a feedback survey to rate the difficulty of each question.</p>
                <p class="mb-0">3. Once your instructor grades your submission, you can view your errors and feedback in the <strong>Mistake Bank</strong>.</p>
            </div>
        </div>
    </div>
</div>
