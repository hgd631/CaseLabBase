@{
    ViewData["Title"] = "Quiz Workspace";
}

<!-- EXAM WORKSPACE PANEL -->
<div id="screen-student-exam" class="screen active" style="width: 100%; max-width: 100%;">
    <div class="glass-panel mb-3 py-3 px-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="badge bg-danger mb-1 text-uppercase text-white" style="font-size: 10px; letter-spacing: 0.05em;">Exam Session</span>
                <h2 id="examTitle" class="fw-bold m-0" style="font-family: var(--font-heading);">Quiz Workspace</h2>
            </div>
            <div class="text-end">
                <span class="text-secondary small d-block">TIMER</span>
                <div id="examTimerDisplay" class="font-monospace fw-bold fs-3 text-cyan">40:00</div>
            </div>
        </div>
    </div>

    <!-- Active workspace which can split -->
    <div id="examWorkspaceLayoutArea" class="row g-3">
        <div class="col-lg-9 mx-auto">
            <div class="glass-panel">
                <div id="studentActiveQuestionsArea">
                    <div class="text-center py-4 text-secondary">
                        <div class="spinner-border spinner-border-sm text-cyan me-2" role="status"></div>
                        Loading questions...
                    </div>
                </div>
                <div class="mt-4">
                    <button class="btn btn-dark-custom btn-lg w-100 py-3 fw-bold" onclick="lockExamAndOpenSurvey()">
                        Submit Exam & Go to Survey
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- REFLECTION SURVEY PANEL -->
<div id="screen-student-survey" class="screen">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="glass-panel">
                <div class="border-bottom border-secondary pb-3 mb-4">
                    <span class="badge bg-indigo mb-1 text-uppercase text-white" style="font-size: 10px; letter-spacing: 0.05em;">Feedback</span>
                    <h2 class="fw-bold m-0" style="font-family: var(--font-heading);">Feedback Survey</h2>
                    <p class="text-secondary small mt-1 mb-0">Rate the overall difficulty of this quiz and write your feedback.</p>
                </div>

                <div class="glass-card p-4" style="background-color: #ffffff; border: 1px solid var(--border-color); border-radius: 12px;">
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-dark d-block">Overall Quiz Difficulty:</label>
                        <div class="survey-emoji-group">
                            <div class="emoji-btn" id="emoji-easy-overall" data-val="Easy" onclick="selectOverallDifficulty('Easy')">
                                😊 <span>Easy</span>
                            </div>
                            <div class="emoji-btn selected" id="emoji-medium-overall" data-val="Medium" onclick="selectOverallDifficulty('Medium')">
                                😐 <span>Medium</span>
                            </div>
                            <div class="emoji-btn" id="emoji-hard-overall" data-val="Hard" onclick="selectOverallDifficulty('Hard')">
                                🤯 <span>Hard</span>
                            </div>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold text-dark d-block">Your Comments / Feedback:</label>
                        <textarea class="form-control" id="survey-comment-overall" rows="4" placeholder="Type your overall feedback here..."></textarea>
                    </div>
                </div>

                <div class="mt-4">
                    <button class="btn btn-dark-custom btn-lg w-100 py-3 fw-bold" onclick="completeSurveyPipeline()">
                        Submit Survey
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
