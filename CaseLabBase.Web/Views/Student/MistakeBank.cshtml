@{
    ViewData["Title"] = "Student Mistake Bank Portal";
}

<div class="row g-4">
    <!-- Left Navigation Panel -->
    <div class="col-md-3">
        <div class="glass-panel p-3">
            <h5 class="fw-bold mb-4 ps-2" style="font-family: var(--font-heading);">Workspace Links</h5>
            <ul class="nav flex-column gap-2">
                <li class="nav-item">
                    <a class="nav-link text-secondary hover-indigo rounded px-3 py-2 fw-medium d-flex align-items-center" href="/Student/Dashboard">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
                        Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark bg-light rounded px-3 py-2 fw-medium border-start border-3 border-indigo d-flex align-items-center justify-content-between" href="/Student/MistakeBank">
                        <span class="d-flex align-items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2 text-indigo"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                            Mistake Bank
                        </span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-secondary hover-indigo rounded px-3 py-2 fw-medium d-flex align-items-center" href="/Forum">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                        Course Forum
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Main Workspace Content -->
    <div class="col-md-9">
        <div class="glass-panel mb-4">
            <h2 class="fw-bold mb-2" style="font-family: var(--font-heading);">Private Mistake Bank</h2>
            <p class="text-secondary small mb-4">Review grading evaluations, assigned error tags, and engage in private dispute dialogues with your instructor.</p>

            <div id="mistakeBankCoreContent">
                <div class="text-center py-4 text-secondary">
                    <div class="spinner-border spinner-border-sm text-cyan me-2" role="status"></div>
                    Retrieving grading reviews...
                </div>
            </div>
        </div>

        <div class="glass-panel">
            <h5 class="fw-bold mb-3" style="font-family: var(--font-heading);">Private Dispute Process Rules</h5>
            <div class="small text-secondary lh-lg">
                <p class="mb-2">1. If you believe your essay code response was marked incorrectly or has special considerations, you can click <strong>"Dispute Grade"</strong> to open a private 1-on-1 discussion thread.</p>
                <p class="mb-0">2. Dr. Ali Bayeh (Instructor) can review your statements, post feedback, and override your grade directly from the instructor audit dashboard.</p>
            </div>
        </div>
    </div>
</div>
